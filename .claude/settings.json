{
  "permissions": {
    "allow": [
      "Bash(python -m unittest:*)",
      "Bash(ruff check:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(docker compose config:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_check.py\"" }
        ]
      }
    ]
  }
}
