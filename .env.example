# local = padroes inseguros permitidos (portas so em 127.0.0.1, segredos padrao,
# usuarios de teste no Keycloak). Qualquer outro valor faz a API e o worker
# recusarem iniciar com NEXUS_SECRETS_KEY, QDRANT_API_KEY, POSTGRES_PASSWORD ou
# KEYCLOAK_BACKEND_CLIENT_SECRET ausentes ou iguais aos padroes (SPEC-007).
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=4200
POSTGRES_PORT=5432
QDRANT_PORT=6333

POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
DATABASE_URL=postgresql+psycopg://nexus:nexus@postgres:5432/nexus

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=nexus-local

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_VECTOR_SIZE=384
# Vazio = limite de sequencia do modelo carregado (128 no modelo acima).
CHUNK_MAX_TOKENS=
CHUNK_OVERLAP_SENTENCES=1
CHUNK_PREFIX_MAX_TOKENS=32
# Arquivos originais: limite por arquivo (25 MB, RN-30) e diretorio no
# container, compartilhado por backend e worker (volume documents_data).
UPLOAD_MAX_BYTES=26214400
DOCUMENTS_STORAGE_PATH=/app/data/documents
# Ingestao em segundo plano (SPEC-005). Tentativas por documento e tempo apos
# o qual um job reservado volta a fila (worker parado ou travado).
INGESTION_MAX_ATTEMPTS=3
INGESTION_JOB_TIMEOUT_SECONDS=600
# Idiomas do OCR local, no formato do Tesseract.
OCR_LANGUAGES=por+eng
# Maximo de paginas sem texto (OCR) por PDF; acima disso o documento falha.
OCR_MAX_PAGES=200
# Cache dos modelos locais. Com HF_HUB_OFFLINE=1 nenhum download e tentado.
HF_HOME=/app/cache
HF_HUB_OFFLINE=0
# Recuperacao (SPEC-003). Pontos de partida, a calibrar com a avaliacao.
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_CANDIDATES=30
RERANK_TOP_N=5
# Nota minima, de 0 a 1; abaixo dela o trecho nao entra no contexto.
# 0.10: calibrado no CT-22 (nexus-docs, 27 itens) e confirmado em 2026-10-20 no nexus-docs-ampliado
# validado (82 itens, 20 fora do escopo): responde 89% e recusa 90%, a maior media da curva.
# SPEC-012 D9 (revista em 2026-10-27): 0.30 foi testado e tirou 6 respostas do nexus-docs-ampliado
# (citacao 0,935 -> 0,839) sem recusar nenhuma pergunta fora do escopo a mais; volta a 0.10.
# Perguntas que citam um artigo nao dependem desta nota (contexto estrutural).
RELEVANCE_MIN_SCORE=0.10
CONTEXT_TOKEN_BUDGET=2000
HISTORY_TOKEN_BUDGET=1500
# Orcamento quando a pergunta cita um artigo e o contexto e o artigo inteiro (SPEC-012, D8).
# Se o artigo nao couber, a resposta informa os itens que ficaram de fora.
STRUCTURAL_CONTEXT_TOKEN_BUDGET=16000
# Tempo limite, em segundos, das chamadas ao LLM no chat e na avaliacao (SPEC-012, D14).
# Vazio = 30. Com artigos inteiros no contexto o primeiro trecho pode passar de 30 s.
LLM_TIMEOUT_SECONDS=120
# BM25 da busca hibrida. Mudar estes valores exige reindexar os assistentes.
BM25_K1=1.2
BM25_B=0.75
BM25_AVG_LENGTH=64
# Padrao do ambiente (SPEC-008): provedor, modelo e URL tambem podem ser trocados na
# tela de Administracao, sem reiniciar. Gemini: LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Modelo oficial da campanha de validacao (decisao PC-D8, 2026-10-20). A chave continua sendo
# cadastrada na tela de Administracao (cifrada no banco), nunca neste arquivo.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
NEXUS_SECRETS_KEY=change-me-in-local-env

# Autenticacao (SPEC-004). Valores de desenvolvimento; o realm de exemplo esta
# em infra/keycloak/.
KEYCLOAK_PORT=8080
# Endereco do Keycloak visto pelo navegador: e o emissor conferido nos tokens.
KEYCLOAK_URL=http://localhost:8080
# Endereco pelo qual a API busca as chaves publicas (rede do Compose).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=nexus
OIDC_AUDIENCE=nexus-api
OIDC_FRONTEND_CLIENT_ID=nexus-frontend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Endereco do frontend visto pelo navegador. O realm de exemplo usa este valor
# em redirectUris, webOrigins e no logout do cliente nexus-frontend; vale na
# primeira importacao do realm (ver infra/keycloak/README.md).
NEXUS_FRONTEND_URL=http://localhost:4200
# Cliente de servico do backend (PC-D6): so le a lista de grupos do realm,
# para escolher grupos na tela em vez de digitar. O mesmo segredo e passado
# ao Keycloak na importacao do realm. Troque fora do ambiente local; vazio
# desliga a lista (a tela volta ao campo de texto).
KEYCLOAK_BACKEND_CLIENT_ID=nexus-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=nexus-backend-dev-secret
# Origens do frontend aceitas pela API, separadas por virgula. Inclua
# NEXUS_FRONTEND_URL.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Retencao da auditoria em dias (RNF-24). Aplicada so pelo comando
# python -m src.cli.purge_audit; a API nunca apaga eventos.
AUDIT_RETENTION_DAYS=365

LOG_LEVEL=INFO
EVAL_REGRESSION_TOLERANCE=0.02

API_BASE_URL=http://localhost:8000

# Operacao e governanca (SPEC-006).
# Limite de perguntas por usuario (D3). Valores padrao; o administrador os
# ajusta na tela de consumo. 0 desliga a janela.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=500
# Custo estimado por mil tokens (gemini-3.8-flash, preco introdutorio do Google ate
# 31/12/2026: US$ 0,75 e 3,75 por milhao; dobra em 01/01/2027). Estimativa, nao fatura;
# ajuste ao trocar de modelo ou de provedor.
LLM_PRICE_INPUT_PER_1K=0.00075
LLM_PRICE_OUTPUT_PER_1K=0.00375
LLM_PRICE_CURRENCY=USD
# Rastreamento (D1, D2). Vazio: sem exportacao, so metricas em /metrics.
# Com o perfil observabilidade: http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nexus-backend
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Backup diario (D5): pasta no computador, retencao em dias e intervalo.
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
# Prazo maximo da pausa de ingestao durante o backup (D10). A pausa e liberada
# ao fim do backup; o prazo so vale se o backup morrer sem libera-la.
BACKUP_PAUSE_MAX_SECONDS=3600
